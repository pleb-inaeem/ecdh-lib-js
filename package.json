{
  "name": "@ecdh/core",
  "version": "0.1.0",
  "description": "Advanced ECDH (Elliptic Curve Diffie-Hellman) library for JavaScript with multiple curves, KDFs, and encryption support",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.{js,ts}",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ecdh",
    "elliptic-curve",
    "diffie-hellman",
    "cryptography",
    "encryption",
    "key-exchange",
    "curve25519",
    "p256",
    "secp256k1",
    "ecies",
    "kdf",
    "hkdf"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/ecdh-lib-js.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/ecdh-lib-js/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/ecdh-lib-js#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rollup": "^4.12.0",
    "ts-jest": "^29.1.2",
    "typedoc": "^0.25.8",
    "typescript": "^5.3.3"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
